# Copy this file to .env and fill in your real key:
#   cp .env.example .env
# server.py loads .env automatically on startup. Never commit the real .env.
# For Docker, put these values in /etc/dinnertable.env instead (see docker-compose.yml).

ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5
# PORT=8002

# Run photo scans (inventory) on a local Ollama vision model instead of Anthropic:
# OLLAMA_VISION_MODEL=qwen3.5:9b
# OLLAMA_URL=http://localhost:11434
